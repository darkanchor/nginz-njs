{
  "name": "nginz-njs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build":        "bun scripts/build.js",
    "build:module": "bun scripts/build.js",
    "test:unit":    "bun scripts/test.js",
    "test:int":     "find . -path './modules/*/tests/basic/do.test.js' | xargs bun test",
    "test:native":  "find . -path './modules/*/tests/**/do.test.js' | xargs bun test",
    "test":         "bun scripts/test.js && find . -path './modules/*/tests/basic/do.test.js' | xargs bun test",
    "deploy":       "bun scripts/deploy.js",
    "clean":        "rm -rf dist modules/*/build modules/*/manifest.toml"
  },
  "devDependencies": {}
}
